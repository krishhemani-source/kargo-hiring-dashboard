# Google Gemini - scores CVs and writes briefs/drafts. Only redacted CV text is sent.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Tried in order if the primary is overloaded or out of daily quota (free tier is ~20 requests/day per model).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Resend - sends email only when you click Send.
RESEND_API_KEY=
# Leave empty to use onboarding@resend.dev (free tier: only delivers to your own Resend account email).
FROM_EMAIL=
# Your email. In TEST_MODE every email goes here instead of the candidate. Must be your Resend account email on the free tier.
FOUNDER_EMAIL=
FOUNDER_NAME=Arjun

# true: every email is redirected to FOUNDER_EMAIL with "[TEST → candidate@email]" in the subject.
TEST_MODE=true

# How many CVs to score in parallel.
LLM_WORKERS=2

# Dashboard login. Required on Vercel; leave empty locally for no login.
DASHBOARD_PASSWORD=
# Optional: signs login cookies. Defaults to a value derived from DASHBOARD_PASSWORD.
SESSION_SECRET=

# Neon Postgres. Set automatically on Vercel by the Neon integration. Leave empty locally to use data/kargo.db (SQLite).
DATABASE_URL=
